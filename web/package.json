{
  "name": "docflow-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "build": "vue-tsc --noEmit && vite build",
    "build:demo": "vue-tsc --noEmit && vite build --mode demo",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:demo && playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.64.0",
    "@tanstack/vue-query": "5.105.0",
    "@vueuse/core": "^15.0.0",
    "aws-amplify": "6.22.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.5.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
